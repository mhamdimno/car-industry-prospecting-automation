{
  "name": "Car Industry Prospecting Automation",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Car Lead Submission",
        "formDescription": "Submit a request for automotive leads",
        "fields": {
          "values": [
            { "fieldType": "text", "name": "industry", "label": "Industry", "placeholder": "Automotive" },
            { "fieldType": "text", "name": "country", "label": "Country", "placeholder": "Saudi Arabia" },
            { "fieldType": "text", "name": "city", "label": "City", "placeholder": "Riyadh" },
            { "fieldType": "text", "name": "keyword", "label": "Keyword", "placeholder": "car dealership" }
          ]
        }
      },
      "id": "trigger-form",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [240, 260]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.apify.com/v2/acts/{{YourActorName}}/runs?token={{$env.APIFY_API_TOKEN}}",
        "jsonParameters": true,
        "options": {
          "bodyContentType": "json"
        },
        "sendBody": true,
        "specifyBody": "json",
        "body": "={{ { keyword: $json.keyword, country: $json.country, city: $json.city, industry: $json.industry } }}"
      },
      "id": "apify-run",
      "name": "Run an Actor and get dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 260]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-node",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [760, 260]
    },
    {
      "parameters": {
        "jsCode": "const rows = Array.isArray($json) ? $json : ($json.data || $json.dataset || []);

return rows.map((item) => ({
  name: item.name || item.fullName || '',
  company: item.company || item.companyName || '',
  jobTitle: item.jobTitle || item.position || item.role || '',
  email: item.email || '',
  phone: item.phone || item.mobile || '',
  website: item.website || item.companyWebsite || '',
  linkedin: item.linkedin || item.linkedinUrl || '',
  country: item.country || '',
  city: item.city || '',
  industry: item.industry || 'Automotive',
  source: 'Apify + n8n',
  leadStatus: 'New',
  notes: item.notes || '',
  createdAt: new Date().toISOString()
}));"
      },
      "id": "code-node",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [990, 260]
    },
    {
      "parameters": {
        "operation": "create",
        "baseId": "{{ $env.AIRTABLE_BASE_ID }}",
        "table": "Prospects",
        "columns": {
          "name": "={{ $json.name }}",
          "company": "={{ $json.company }}",
          "jobTitle": "={{ $json.jobTitle }}",
          "email": "={{ $json.email }}",
          "phone": "={{ $json.phone }}",
          "website": "={{ $json.website }}",
          "linkedin": "={{ $json.linkedin }}",
          "country": "={{ $json.country }}",
          "city": "={{ $json.city }}",
          "industry": "={{ $json.industry }}",
          "source": "={{ $json.source }}",
          "leadStatus": "={{ $json.leadStatus }}",
          "notes": "={{ $json.notes }}",
          "createdAt": "={{ $json.createdAt }}"
        }
      },
      "id": "airtable-create",
      "name": "Create a record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1240, 260]
    }
  ],
  "connections": {
    "trigger-form": {
      "main": [
        [
          { "node": "apify-run", "type": "main", "index": 0 }
        ]
      ]
    },
    "apify-run": {
      "main": [
        [
          { "node": "wait-node", "type": "main", "index": 0 }
        ]
      ]
    },
    "wait-node": {
      "main": [
        [
          { "node": "code-node", "type": "main", "index": 0 }
        ]
      ]
    },
    "code-node": {
      "main": [
        [
          { "node": "airtable-create", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Automated car prospecting flow using Apify and Airtable"
  }
}
